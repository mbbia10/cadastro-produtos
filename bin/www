#!/usr/bin/env node

const app = require('../app');
const debug = require('debug')('cadastro-produtos:server');
const http = require('http');
const { sequelize } = require('../models');

const port = process.env.PORT || 3000;
app.set('port', port);

const server = http.createServer(app);

// Cria/atualiza as tabelas antes de aceitar requisições
sequelize.sync().then(() => {
  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);
});

function onError(error) {
  if (error.syscall !== 'listen') throw error;
  if (error.code === 'EACCES') {
    console.error('Porta ' + port + ' requer privilégios elevados');
    process.exit(1);
  }
  if (error.code === 'EADDRINUSE') {
    console.error('Porta ' + port + ' já está em uso');
    process.exit(1);
  }
  throw error;
}

function onListening() {
  const addr = server.address();
  debug('Listening on port ' + addr.port);
  console.log('Servidor rodando em http://localhost:' + addr.port);
}
